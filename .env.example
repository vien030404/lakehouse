# ---------------------------------------------------------------------------
# Biến môi trường dùng chung cho docker-compose.yml.
# Sao chép thành `.env` trước khi chạy. Mật khẩu dưới đây chỉ dành cho môi
# trường local; `.env` nằm trong .gitignore để mật khẩu thật không bị commit.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=trinodemo

# --- Phiên bản image: ghim cố định để build lặp lại được ---------------------
TRINO_VERSION=483
ICEBERG_REST_VERSION=1.10.1
POSTGRES_VERSION=17
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
SUPERSET_VERSION=5.0.0
# Đổi phiên bản Spark thì phải đổi theo hadoop-aws và iceberg-spark-runtime
# (xem spark/Dockerfile).
SPARK_VERSION=3.5.9

# --- MinIO: object storage tương thích S3 -----------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
LAKEHOUSE_BUCKET=lakehouse
RAW_BUCKET=raw
EXCHANGE_BUCKET=exchange
CHECKPOINT_BUCKET=checkpoints

# --- postgres-ops: backend của REST catalog Iceberg và metadata Airflow ------
# POSTGRES_DB là database Postgres tự tạo ở lần khởi động đầu, và healthcheck
# kết nối vào đó. Giữ nguyên tên: iceberg-rest trỏ tới
# jdbc:postgresql://postgres-ops:5432/iceberg_catalog trong docker-compose.yml.
POSTGRES_OPS_DB=iceberg_catalog
POSTGRES_OPS_USER=ops
POSTGRES_OPS_PASSWORD=ops123


# --- Trino -----------------------------------------------------------------
# NONE = tắt fault-tolerant execution, nhẹ tài nguyên nhất.
# TASK = bật FTE mức task, dữ liệu trung gian spool qua MinIO
#        (xem trino/coordinator/exchange-manager.properties).
TRINO_RETRY_POLICY=TASK

# --- Superset (BI) ---------------------------------------------------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Sinh khoá mới: python -c "import secrets;print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=qJ8xN2vT5wLpR7yH3kM9dF4gB6sA1zC0eU8iO5rY2tW

# --- Luồng stream: datagen -> Redpanda -> Spark Streaming -------------------
REDPANDA_VERSION=v26.2.3
AIRFLOW_VERSION=3.3.2
# Tốc độ đồng hồ mô phỏng: 1 phút thật = TIME_SCALE phút mô phỏng.
# 60 -> 1 ngày mô phỏng = 24 phút thật; 1 -> thời gian thực.
TIME_SCALE=60
# Đồng hồ mô phỏng bắt đầu ngay sau đơn cuối cùng của dataset Olist
# (2018-10-17) để chuỗi thời gian liền mạch. Chỉ dùng ở lần chạy đầu; sau đó
# đồng hồ được đọc lại từ volume datagen-state.
SIM_START=2018-10-18T00:00:00
# Chu kỳ micro-batch của Spark Structured Streaming
STREAM_TRIGGER=30 seconds
